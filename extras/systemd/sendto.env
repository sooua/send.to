# send.to configuration for the systemd unit.
# Install to /etc/sendto/sendto.env (chmod 0640, owned by root:sendto).
#
# Every CLI flag has an environment equivalent: --listener is LISTENER,
# --max-upload-size is MAX_UPLOAD_SIZE, and so on. Run `sendto --help` for
# the full list.

# ---- Networking ----
# Bind to loopback and terminate TLS in a reverse proxy. To serve directly,
# use :18080 and set TLS_LISTENER / TLS_CERT_FILE / TLS_PRIVATE_KEY.
LISTENER=127.0.0.1:18080

# ---- Storage ----
PROVIDER=local
BASEDIR=/var/lib/sendto/data

# Uploads without a Content-Length, and every upload when the ClamAV prescan
# is on, are spooled here first. Keep it on the same filesystem as BASEDIR so
# a large upload is bounded by disk rather than by RAM.
TEMP_PATH=/var/lib/sendto/tmp

# Static frontend. Omit to run API-only.
#WEB_PATH=/usr/share/sendto/web

# ---- Limits ----
# Max upload size in KB; 0 means unlimited, which lets one upload fill BASEDIR.
MAX_UPLOAD_SIZE=1048576
# Requests per minute per IP, shared across all routes. 0 disables.
RATE_LIMIT=60

# ---- Lifecycle ----
PURGE_DAYS=30
PURGE_INTERVAL=1
SHUTDOWN_TIMEOUT=30s

# ---- Behind a reverse proxy ----
#PROXY_PATH=/send
#PROXY_PORT=443
#FORCE_HTTPS=true

# ---- Optional auth ----
#HTTP_AUTH_USER=admin
#HTTP_AUTH_PASS=change-me
#HTTP_AUTH_HTPASSWD=/etc/sendto/htpasswd

# ---- Optional CORS ----
#CORS_DOMAINS=https://example.com

# ---- Optional virus scanning ----
#CLAMAV_HOST=tcp://127.0.0.1:3310
#PERFORM_CLAMAV_PRESCAN=true
#VIRUSTOTAL_KEY=

# ---- Optional S3 backend (set PROVIDER=s3) ----
#S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
#S3_REGION=us-east-1
#AWS_ACCESS_KEY=
#AWS_SECRET_KEY=
#BUCKET=
