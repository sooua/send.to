---
interface Props {
  title?: string;
  titleKey?: string;
  code?: string;
}

const { title = "terminal", titleKey, code } = Astro.props;
---

<div class="code-block group relative overflow-hidden rounded-lg border border-border bg-codeblock">
  <div class="flex items-center justify-between border-b border-border bg-surface/80 px-4 py-2">
    <div class="flex items-center gap-2">
      <div class="flex gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-zinc-700 dark:bg-zinc-600"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-zinc-700 dark:bg-zinc-600"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-zinc-700 dark:bg-zinc-600"></span>
      </div>
      <span
        class="ml-2 font-mono text-xs text-muted-dark"
        {...(titleKey ? { "data-i18n": titleKey } : {})}
      >{title}</span>
    </div>
    <button
      class="copy-btn flex items-center gap-1 rounded px-2 py-1 font-mono text-xs text-muted-dark opacity-0 transition-all hover:bg-surface-light hover:text-primary group-hover:opacity-100"
      data-i18n="code.copy"
    >
      <svg class="copy-icon h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg class="check-icon hidden h-3.5 w-3.5 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span class="copy-label">Copy</span>
    </button>
  </div>
  <div class="relative overflow-x-auto p-4">
    <pre class="font-mono text-sm leading-relaxed">{code ? <Fragment set:html={code} /> : <slot />}</pre>
  </div>
</div>

<script>
  function initCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
      if (btn.dataset.copyInit) return;
      btn.dataset.copyInit = "true";
      btn.addEventListener("click", async () => {
        const block = btn.closest(".code-block");
        if (!block) return;
        const pre = block.querySelector("pre");
        if (!pre) return;

        // Extract clean text: remove leading $ and PS> prompts per line
        const raw = pre.textContent?.trim() ?? "";
        const text = raw
          .split("\n")
          .map((line) => line.replace(/^\$\s?/, "").replace(/^PS>\s?/, ""))
          .join("\n");

        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // fallback for non-HTTPS contexts
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.left = "-9999px";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          try {
            document.execCommand("copy");
          } catch (_) {
            // ignore
          }
          document.body.removeChild(ta);
        }

        const copyIcon = btn.querySelector(".copy-icon") as HTMLElement;
        const checkIcon = btn.querySelector(".check-icon") as HTMLElement;
        const label = btn.querySelector(".copy-label") as HTMLElement;

        copyIcon.classList.add("hidden");
        checkIcon.classList.remove("hidden");

        const lang = (window as any).__LANG__ || localStorage.getItem("lang") || "en";
        const copiedText: Record<string, string> = {
          en: "Copied!",
          zh: "已复制！",
          ja: "コピー済み！",
        };
        label.textContent = copiedText[lang] || "Copied!";

        setTimeout(() => {
          copyIcon.classList.remove("hidden");
          checkIcon.classList.add("hidden");
          const copyText: Record<string, string> = {
            en: "Copy",
            zh: "复制",
            ja: "コピー",
          };
          label.textContent = copyText[lang] || "Copy";
        }, 2000);
      });
    });
  }

  // Support both regular page load and View Transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCopyButtons);
  } else {
    initCopyButtons();
  }
  document.addEventListener("astro:page-load", initCopyButtons);
</script>
