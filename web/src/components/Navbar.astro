---
import LanguageSwitcher from "./LanguageSwitcher";

const navLinks = [
  { href: "/", label: "Home", i18nKey: "nav.home" },
  { href: "/use-cases", label: "Use cases", i18nKey: "nav.useCases" },
  { href: "/api-docs", label: "API", i18nKey: "nav.apiDocs" },
  { href: "/about", label: "About", i18nKey: "nav.about" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <div class="flex items-center gap-10">
      <a href="/" class="font-serif text-[22px] font-medium text-primary transition-opacity hover:opacity-80">
        send.to
      </a>

      <div class="hidden items-center gap-8 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              data-i18n={link.i18nKey}
              class:list={[
                "text-[15px] transition-colors",
                currentPath === link.href
                  ? "font-medium text-primary"
                  : "text-muted hover:text-primary",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hidden items-center gap-3 md:flex">
      <LanguageSwitcher client:load />
      <a
        href="https://github.com/sooua/send.to"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sand btn-sm"
        aria-label="GitHub repository"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        GitHub
      </a>
      <a href="#upload" class="btn btn-primary btn-sm">
        Get started →
      </a>
    </div>

    <!-- Mobile -->
    <div class="flex items-center gap-3 md:hidden">
      <LanguageSwitcher client:load />
      <button
        id="mobile-menu-btn"
        class="text-primary"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="close-icon" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu border-t border-border bg-background md:hidden">
    <div class="space-y-1 px-6 py-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-i18n={link.i18nKey}
            class:list={[
              "block py-2 text-[15px]",
              currentPath === link.href ? "font-medium text-primary" : "text-muted",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href="#upload" class="btn btn-primary btn-sm mt-3 w-full">Get started →</a>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    if (!btn || !menu || !menuIcon || !closeIcon) return;
    if (btn.dataset.menuInit) return;
    btn.dataset.menuInit = "true";

    btn.addEventListener("click", () => {
      menu.classList.toggle("is-open");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileMenu);
  } else {
    initMobileMenu();
  }
  document.addEventListener("astro:page-load", initMobileMenu);
</script>

<style>
  .mobile-menu {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.25s ease-out, opacity 0.2s ease-out;
  }
  .mobile-menu.is-open {
    max-height: 400px;
    opacity: 1;
  }
</style>
