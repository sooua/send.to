---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/translations";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "send.to — Easy and fast file sharing from the command line.",
  description = "Easy and fast file sharing from the command line. Upload files and get a shareable link instantly.",
} = Astro.props;

const translationsJson = JSON.stringify(translations);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- i18n + language detection — no flash, runs before paint -->
    <script is:inline define:vars={{ translationsJson }}>
      (function () {
        window.__I18N__ = JSON.parse(translationsJson);

        const saved = localStorage.getItem("lang");
        if (saved && window.__I18N__[saved]) {
          window.__LANG__ = saved;
        } else {
          const nav = navigator.language || navigator.userLanguage || "";
          const prefix = nav.split("-")[0].toLowerCase();
          const supported = Object.keys(window.__I18N__);
          window.__LANG__ = supported.indexOf(prefix) !== -1 ? prefix : "en";
        }

        document.documentElement.lang = window.__LANG__;
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-primary">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Swap data-i18n elements after DOM ready for non-English locales -->
    <script is:inline>
      (function () {
        const lang = window.__LANG__;
        if (!lang || lang === "en") return;
        const dict = window.__I18N__?.[lang];
        if (!dict) return;
        document.querySelectorAll("[data-i18n]").forEach(function (el) {
          const key = el.getAttribute("data-i18n");
          if (key && dict[key]) el.textContent = dict[key];
        });
      })();
    </script>

    <!-- Scroll-reveal via IntersectionObserver -->
    <script is:inline>
      (function () {
        function init() {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.querySelectorAll(".animate-on-scroll").forEach(function (el) {
              el.classList.add("is-visible");
            });
            return;
          }
          const observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1 }
          );
          document.querySelectorAll(".animate-on-scroll").forEach(function (el) {
            observer.observe(el);
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
        document.addEventListener("astro:page-load", init);
      })();
    </script>
  </body>
</html>
