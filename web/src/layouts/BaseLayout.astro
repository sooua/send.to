---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../i18n/translations";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "send.to - Easy and fast file sharing from the command line.",
  description = "Easy and fast file sharing from the command line. Upload files and get a shareable link instantly.",
} = Astro.props;

// Serialize translations for client-side use
const translationsJson = JSON.stringify(translations);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Theme + i18n init: prevent flash -->
    <script is:inline define:vars={{ translationsJson }}>
      (function() {
        // Theme
        var theme = localStorage.getItem("theme") || "dark";
        document.documentElement.setAttribute("data-theme", theme);

        // i18n: store translations globally for client-side use
        window.__I18N__ = JSON.parse(translationsJson);

        // Language detection: localStorage > browser language > "en"
        var saved = localStorage.getItem("lang");
        if (saved && window.__I18N__[saved]) {
          window.__LANG__ = saved;
        } else {
          var nav = navigator.language || navigator.userLanguage || "";
          var prefix = nav.split("-")[0].toLowerCase();
          var supported = Object.keys(window.__I18N__);
          window.__LANG__ = supported.indexOf(prefix) !== -1 ? prefix : "en";
        }

        // Update html lang attribute
        document.documentElement.lang = window.__LANG__;
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Client-side i18n: swap data-i18n elements after DOM ready -->
    <script is:inline>
      (function() {
        var lang = window.__LANG__;
        if (!lang || lang === "en") return; // English is the default, no swap needed
        var t = window.__I18N__;
        if (!t || !t[lang]) return;
        var dict = t[lang];
        document.querySelectorAll("[data-i18n]").forEach(function(el) {
          var key = el.getAttribute("data-i18n");
          if (key && dict[key]) {
            el.textContent = dict[key];
          }
        });
      })();
    </script>

    <!-- Scroll-triggered animations via Intersection Observer -->
    <script is:inline>
      (function() {
        function initScrollAnimations() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
              el.classList.add('is-visible');
            });
            return;
          }

          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1 });

          document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
            observer.observe(el);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollAnimations);
        } else {
          initScrollAnimations();
        }
        document.addEventListener('astro:page-load', initScrollAnimations);
      })();
    </script>
  </body>
</html>
