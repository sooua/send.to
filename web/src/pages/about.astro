---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
---

<BaseLayout title="About - send.to">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="mb-3 font-mono text-3xl font-bold text-primary" data-i18n="about.title">About</h1>
    <p class="mb-12 text-muted" data-i18n="about.subtitle">
      send.to is an open-source file sharing service that makes it easy to share files from the command line.
    </p>

    <div class="space-y-10">
      <!-- What is send.to -->
      <section class="animate-on-scroll">
        <h2 class="mb-3 font-mono text-lg font-semibold text-primary" data-i18n="about.whatIs">What is send.to?</h2>
        <p class="text-sm leading-relaxed text-muted" data-i18n="about.whatIsDesc">
          send.to is a lightweight, self-hosted file sharing service built with Go. It compiles to a single static binary with zero external dependencies, making it trivial to deploy. Upload files via curl or the web interface, get a shareable link, and files auto-expire based on your configuration.
        </p>
      </section>

      <!-- Features -->
      <section class="animate-on-scroll">
        <h2 class="mb-6 font-mono text-lg font-semibold text-primary" data-i18n="about.features">Features</h2>

        <!-- File Transfer -->
        <h3 class="mb-4 font-mono text-sm font-medium text-accent" data-i18n="about.featureTransfer">File Transfer</h3>
        <div class="mb-8 grid gap-3 sm:grid-cols-2">
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.shareUrl">Share files with a URL</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.maxDownloads">Set maximum download count per file</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.multiUpload">Upload multiple files at once</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.resumable">Resumable downloads via HTTP Range requests</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.expiration">Auto-expiration with configurable TTL and purge interval</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.deleteToken">Delete files with a unique deletion token</p>
          </div>
        </div>

        <!-- Security -->
        <h3 class="mb-4 font-mono text-sm font-medium text-accent" data-i18n="about.featureSecurity">Security</h3>
        <div class="mb-8 grid gap-3 sm:grid-cols-2">
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.encryption">Server-side OpenPGP AES-256 encryption via headers</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.gpgOpenssl">Client-side encryption with GPG or OpenSSL</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.virusScan">Virus scanning with ClamAV and VirusTotal</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.auth">HTTP Basic Auth, htpasswd, and IP whitelist/blacklist</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.tls">Automatic TLS via Let's Encrypt</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.rateLimit">Per-IP rate limiting</p>
          </div>
        </div>

        <!-- Preview & Clients -->
        <h3 class="mb-4 font-mono text-sm font-medium text-accent" data-i18n="about.featurePreview">Preview & Clients</h3>
        <div class="mb-8 grid gap-3 sm:grid-cols-2">
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.preview">File preview for images, video, audio, and Markdown</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.altClients">Works with curl, wget, HTTPie, and PowerShell</p>
          </div>
        </div>

        <!-- Infrastructure -->
        <h3 class="mb-4 font-mono text-sm font-medium text-accent" data-i18n="about.featureInfra">Infrastructure</h3>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.storage">Multiple storage backends: local, S3, Google Drive, Storj</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <p class="text-sm text-muted" data-i18n="feature.selfHosted">Single binary deployment with Docker support</p>
          </div>
        </div>
      </section>

      <!-- Self-hosting -->
      <section class="animate-on-scroll">
        <h2 class="mb-4 font-mono text-lg font-semibold text-primary" data-i18n="about.selfHosting">Self-hosting</h2>
        <p class="mb-4 text-sm text-muted" data-i18n="about.selfHostingDesc">
          Deploy your own instance with Docker in seconds:
        </p>

        <div class="space-y-4">
          <CodeBlock title="docker run" titleKey="code.dockerRun" code={`<span class="code-prompt">$</span> docker run -p 8080:8080 \\
    -v /tmp/send.to:/data \\
    sooua/sendto \\
    --provider local --basedir /data`} />

          <CodeBlock title="docker run with S3" titleKey="code.dockerRunS3" code={`<span class="code-prompt">$</span> docker run -p 8080:8080 \\
    -e AWS_ACCESS_KEY=your-key \\
    -e AWS_SECRET_KEY=your-secret \\
    sooua/sendto \\
    --provider s3 --bucket my-bucket`} />

          <CodeBlock title="with encryption & limits" titleKey="code.dockerAdvanced" code={`<span class="code-prompt">$</span> docker run -p 8080:8080 \\
    sooua/sendto \\
    --provider local --basedir /data \\
    --max-upload-size 5242880 \\
    --purge-days 14 --purge-interval 1 \\
    --rate-limit 60`} />
        </div>
      </section>

      <!-- Tech Stack -->
      <section>
        <h2 class="mb-4 font-mono text-lg font-semibold text-primary" data-i18n="about.techStack">Tech Stack</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-border bg-surface px-4 py-3">
            <span class="font-mono text-xs text-muted-dark" data-i18n="tech.language">Language</span>
            <p class="text-sm text-primary">Go 1.22+</p>
          </div>
          <div class="rounded-lg border border-border bg-surface px-4 py-3">
            <span class="font-mono text-xs text-muted-dark" data-i18n="tech.router">Router</span>
            <p class="text-sm text-primary">gorilla/mux</p>
          </div>
          <div class="rounded-lg border border-border bg-surface px-4 py-3">
            <span class="font-mono text-xs text-muted-dark" data-i18n="tech.encryption">Encryption</span>
            <p class="text-sm text-primary">OpenPGP AES-256 (ProtonMail go-crypto)</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <span class="font-mono text-xs text-muted-dark" data-i18n="tech.deployment">Deployment</span>
            <p class="text-sm text-primary">Single binary / Docker</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <span class="font-mono text-xs text-muted-dark" data-i18n="tech.storage">Storage</span>
            <p class="text-sm text-primary">Local / S3 / Google Drive / Storj</p>
          </div>
          <div class="card-hover rounded-lg border border-border bg-surface px-4 py-3">
            <span class="font-mono text-xs text-muted-dark" data-i18n="tech.frontend">Frontend</span>
            <p class="text-sm text-primary">Astro + React Islands</p>
          </div>
        </div>
      </section>

      <!-- Links -->
      <section class="animate-on-scroll">
        <h2 class="mb-4 font-mono text-lg font-semibold text-primary" data-i18n="about.links">Links</h2>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://github.com/sooua/send.to"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press rounded-lg border border-border bg-surface px-4 py-2 text-sm text-muted transition-all duration-200 hover:border-border-light hover:text-primary hover:shadow-lg"
            data-i18n="about.github"
          >
            GitHub Repository
          </a>
          <a
            href="https://github.com/sooua/send.to/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press rounded-lg border border-border bg-surface px-4 py-2 text-sm text-muted transition-all duration-200 hover:border-border-light hover:text-primary hover:shadow-lg"
            data-i18n="about.issues"
          >
            Report an Issue
          </a>
          <a
            href="https://github.com/sooua/send.to/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-press rounded-lg border border-border bg-surface px-4 py-2 text-sm text-muted transition-all duration-200 hover:border-border-light hover:text-primary hover:shadow-lg"
            data-i18n="footer.license"
          >
            MIT License
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
