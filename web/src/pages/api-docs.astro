                  <td class="px-4 py-2">Successful upload, download, or deletion</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">206</td>
                  <td class="px-4 py-2 font-mono text-xs">Partial Content</td>
                  <td class="px-4 py-2">Range request fulfilled successfully</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-danger">401</td>
                  <td class="px-4 py-2 font-mono text-xs">Unauthorized</td>
                  <td class="px-4 py-2">HTTP Basic Auth required but not provided</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-danger">403</td>
                  <td class="px-4 py-2 font-mono text-xs">Forbidden</td>
                  <td class="px-4 py-2">IP address is blacklisted</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-danger">404</td>
                  <td class="px-4 py-2 font-mono text-xs">Not Found</td>
                  <td class="px-4 py-2">File does not exist or has expired</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-danger">412</td>
                  <td class="px-4 py-2 font-mono text-xs">Precondition Failed</td>
                  <td class="px-4 py-2">Virus detected during ClamAV pre-scan</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-danger">413</td>
                  <td class="px-4 py-2 font-mono text-xs">Request Entity Too Large</td>
                  <td class="px-4 py-2">File exceeds --max-upload-size limit</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-danger">429</td>
                  <td class="px-4 py-2 font-mono text-xs">Too Many Requests</td>
                  <td class="px-4 py-2"
                    >Past the --rate-limit request budget, or past the hourly --per-ip-upload-quota
                    for this source address</td
                  >
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-danger">500</td>
                  <td class="px-4 py-2 font-mono text-xs">Internal Server Error</td>
                  <td class="px-4 py-2">Storage or processing error</td>
                </tr>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-danger">507</td>
                  <td class="px-4 py-2 font-mono text-xs">Insufficient Storage</td>
                  <td class="px-4 py-2"
                    >The instance is at its --max-storage-size, or has no spool space left under
                    --max-temp-size</td
                  >
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
