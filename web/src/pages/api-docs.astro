---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
---

<BaseLayout title="API Documentation — send.to">
  <section class="border-b border-border bg-background">
    <div class="mx-auto max-w-5xl px-6 py-20 text-center sm:py-28">
      <p class="mb-4 text-[13px] font-medium uppercase tracking-wide text-[#c96442]">
        API reference
      </p>
      <h1
        class="font-serif text-[48px] font-medium leading-tight text-primary sm:text-[64px]"
        data-i18n="api.title"
      >
        Everything is a<br />well-named header.
      </h1>
      <p
        class="mx-auto mt-6 max-w-2xl text-[18px] leading-relaxed text-muted"
        data-i18n="api.subtitle"
      >
        send.to provides a simple HTTP API for uploading, downloading, and managing files. All
        endpoints accept standard HTTP methods and can be used with curl or any HTTP client.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-8 lg:flex-row">
      <!-- Sidebar Navigation -->
      <nav class="shrink-0 lg:sticky lg:top-20 lg:h-fit lg:w-48">
        <ul class="space-y-1 text-sm">
          <li>
            <a
              href="#upload"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.upload">Upload</a
            >
          </li>
          <li>
            <a
              href="#resumable"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.resumable">Resumable Upload</a
            >
          </li>
          <li>
            <a
              href="#download"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.download">Download</a
            >
          </li>
          <li>
            <a
              href="#delete"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.delete">Delete</a
            >
          </li>
          <li>
            <a
              href="#archive"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.archive">Archive Download</a
            >
          </li>
          <li>
            <a
              href="#collections"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.collections">Collections</a
            >
          </li>
          <li>
            <a
              href="#owner"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.owner">Upload History</a
            >
          </li>
          <li>
            <a
              href="#scan"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.scan">Virus Scan</a
            >
          </li>
          <li>
            <a
              href="#headers"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.headers">Request Headers</a
            >
          </li>
          <li>
            <a
              href="#response-headers"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.responseHeaders">Response Headers</a
            >
          </li>
          <li>
            <a
              href="#caching"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.caching">Caching</a
            >
          </li>
          <li>
            <a
              href="#languages"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.languages">Languages</a
            >
          </li>
          <li>
            <a
              href="#errors"
              class="block rounded-md px-3 py-1.5 text-muted transition-all duration-200 hover:translate-x-0.5 hover:bg-surface-light hover:text-primary"
              data-i18n="api.errors">Error Codes</a
            >
          </li>
        </ul>
      </nav>

      <!-- Content -->
      <div class="min-w-0 flex-1 space-y-12">
        <!-- Upload -->
        <section id="upload" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.upload">
            Upload
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.uploadDesc">
            Upload a file using PUT or POST. The response contains the download URL. The
            X-Url-Delete response header contains the deletion URL. Send Accept: application/json to
            get a structured response instead.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">PUT</td>
                  <td class="px-4 py-2 font-mono text-xs">/{"{filename}"}</td>
                  <td class="px-4 py-2">Upload a file</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">PUT</td>
                  <td class="px-4 py-2 font-mono text-xs">/put/{"{filename}"}</td>
                  <td class="px-4 py-2">Upload (alias)</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">PUT</td>
                  <td class="px-4 py-2 font-mono text-xs">/upload/{"{filename}"}</td>
                  <td class="px-4 py-2">Upload (alias)</td>
                </tr>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-accent">POST</td>
                  <td class="px-4 py-2 font-mono text-xs">/</td>
                  <td class="px-4 py-2">Form upload (multipart/form-data)</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="space-y-4">
            <CodeBlock
              title="upload a file"
              titleKey="code.uploadFile"
              code={`<span class="code-prompt">$</span> curl --upload-file ./hello.txt https://send.to/hello.txt

<span class="code-string">https://send.to/abc123/hello.txt</span>`}
            />

            <CodeBlock
              title="upload with limits"
              titleKey="code.setLimits"
              code={`<span class="code-prompt">$</span> curl -H <span class="code-string">"Max-Downloads: 5"</span> -H <span class="code-string">"Max-Days: 7"</span> \\
    --upload-file ./hello.txt https://send.to/hello.txt`}
            />

            <CodeBlock
              title="multipart upload"
              titleKey="code.multiUpload"
              code={`<span class="code-prompt">$</span> curl -i -F <span class="code-string">filedata=@/tmp/hello.txt</span> \\
    -F <span class="code-string">filedata=@/tmp/hello2.txt</span> https://send.to/`}
            />
          </div>
        </section>

        <!-- Resumable Upload -->
        <section id="resumable" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.resumable">
            Resumable Upload
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.resumableDesc">
            Upload a large file in chunks so an interrupted transfer continues instead of starting
            over. Open a session with the total size, send chunks with Content-Range, and ask with
            HEAD where to continue. A chunk is all or nothing: a body that arrives short is
            discarded and the offset stays where it was, so the offset you resume from is always one
            you chose. A wrong offset answers 409 with the correct one. The chunk that completes the
            file answers exactly like a plain PUT. Sessions expire after 24 hours, and
            X-Encrypt-Password is refused here — encrypt on the client instead.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">POST</td>
                  <td class="px-4 py-2 font-mono text-xs">/upload/{"{filename}"}</td>
                  <td class="px-4 py-2">Open a session (Upload-Length required)</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">PATCH</td>
                  <td class="px-4 py-2 font-mono text-xs">/upload/{"{id}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Send one chunk (Content-Range required)</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">HEAD</td>
                  <td class="px-4 py-2 font-mono text-xs">/upload/{"{id}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Bytes the server holds (Upload-Offset)</td>
                </tr>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-danger">DELETE</td>
                  <td class="px-4 py-2 font-mono text-xs">/upload/{"{id}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Abandon the session</td>
                </tr>
              </tbody>
            </table>
          </div>

          <CodeBlock
            title="resume a big upload"
            titleKey="code.resumableUpload"
            code={`<span class="code-prompt">$</span> curl -X POST -H <span class="code-string">"Upload-Length: 5368709120"</span> https://send.to/upload/build.tar.gz
<span class="code-comment"># -> 201, Location: https://send.to/upload/SESSION/build.tar.gz</span>

<span class="code-prompt">$</span> curl -X PATCH -H <span class="code-string">"Content-Range: bytes 0-8388607/5368709120"</span> \
    --data-binary @chunk-0 https://send.to/upload/SESSION/build.tar.gz

<span class="code-prompt">$</span> curl -I https://send.to/upload/SESSION/build.tar.gz | grep -i upload-offset`}
          />
        </section>

        <!-- Download -->
        <section id="download" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.download">
            Download
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.downloadDesc">
            Download or preview a file. Supports range requests for resumable downloads. The default
            GET endpoint auto-detects preview vs download based on Accept and Referer headers.
            Max-Downloads counts completed transfers only: Range requests (resumed downloads, media
            seeking) never consume the budget, and neither do aborted transfers. Once the budget or
            Max-Days runs out the file is deleted from storage immediately.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/{"{token}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Download or preview (auto-detect)</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/download/{"{token}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Force download (attachment)</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/get/{"{token}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Force download (alias)</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/inline/{"{token}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Force inline display (browser preview)</td>
                </tr>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-accent">HEAD</td>
                  <td class="px-4 py-2 font-mono text-xs">/{"{token}"}/{"{filename}"}</td>
                  <td class="px-4 py-2">Get file metadata without downloading</td>
                </tr>
              </tbody>
            </table>
          </div>

          <CodeBlock
            title="download a file"
            titleKey="code.downloadFile"
            code={`<span class="code-prompt">$</span> curl https://send.to/abc123/hello.txt -o hello.txt`}
          />
        </section>

        <!-- Delete -->
        <section id="delete" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.delete">
            Delete
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.deleteDesc">
            Delete a file using the deletion token returned in the X-Url-Delete response header
            during upload.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-danger">DELETE</td>
                  <td class="px-4 py-2 font-mono text-xs"
                    >/{"{token}"}/{"{filename}"}/{"{deletionToken}"}</td
                  >
                  <td class="px-4 py-2">Delete a file</td>
                </tr>
              </tbody>
            </table>
          </div>

          <CodeBlock
            title="delete a file"
            titleKey="code.deleteFile"
            code={`<span class="code-prompt">$</span> curl -X DELETE \\
    https://send.to/abc123/hello.txt/del-token-xyz`}
          />
        </section>

        <!-- Archive -->
        <section id="archive" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.archive">
            Archive Download
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.archiveDesc">
            Download multiple files as a single archive (ZIP, TAR, or TAR.GZ). Separate file paths
            with commas.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Format</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">(files).zip</td>
                  <td class="px-4 py-2">ZIP archive</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">(files).tar</td>
                  <td class="px-4 py-2">TAR archive</td>
                </tr>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">(files).tar.gz</td>
                  <td class="px-4 py-2">Compressed TAR</td>
                </tr>
              </tbody>
            </table>
          </div>

          <CodeBlock
            title="combine as archive"
            titleKey="code.combineArchive"
            code={`<span class="code-prompt">$</span> curl https://send.to/<span class="code-string">(token1/hello.txt,token2/hello2.txt).zip</span> \\
    -o files.zip`}
          />
        </section>

        <!-- Collections -->
        <section id="collections" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.collections">
            Collections
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.collectionsDesc">
            Group uploads that already exist behind one link. The collection link renders a page for
            browsers, returns JSON with Accept: application/json, and one share URL per line for
            everything else; adding an archive extension downloads all of it at once. A collection
            owns no bytes: deleting it leaves the files alone, a member that expires or runs out of
            downloads drops off the list, and a collection with nothing left answers 404. At most
            100 files.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">POST</td>
                  <td class="px-4 py-2 font-mono text-xs">/collection</td>
                  <td class="px-4 py-2">Create one from a list of share URLs</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/c/{"{token}"}</td>
                  <td class="px-4 py-2">Landing page, JSON, or one URL per line</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/c/{"{token}"}.zip</td>
                  <td class="px-4 py-2">All of it as one archive (.tar, .tar.gz too)</td>
                </tr>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-danger">DELETE</td>
                  <td class="px-4 py-2 font-mono text-xs">/c/{"{token}"}/{"{deletionToken}"}</td>
                  <td class="px-4 py-2">Delete the collection, not its files</td>
                </tr>
              </tbody>
            </table>
          </div>

          <CodeBlock
            title="one link for several files"
            titleKey="code.createCollection"
            code={`<span class="code-prompt">$</span> curl -X POST -H <span class="code-string">"Content-Type: application/json"</span> \
    -d <span class="code-string">'{"name":"nightly","files":["https://send.to/abc123/app.log","https://send.to/def456/worker.log"]}'</span> \
    https://send.to/collection
<span class="code-comment"># -> https://send.to/c/aB3cD4eF</span>

<span class="code-prompt">$</span> curl -sL https://send.to/c/aB3cD4eF.zip -o logs.zip`}
          />
        </section>

        <!-- Upload History -->
        <section id="owner" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.owner">
            Upload History
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.ownerDesc">
            Send X-Owner-Token with an upload and the server records it in that owner's list, which
            the same token can read back from any machine — the delete links included. There is
            still no account: the server stores only sha256 of the token, never the token itself,
            and an upload without the header stays anonymous. Holding the token is the whole of the
            authorisation, so treat it as a password. Entries drop out when their upload is deleted,
            expires or runs out of downloads; at most 200 are kept per token.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/owner/files</td>
                  <td class="px-4 py-2">This token's uploads (X-Owner-Token required)</td>
                </tr>
              </tbody>
            </table>
          </div>

          <CodeBlock
            title="list what this token uploaded"
            titleKey="code.ownerList"
            code={`<span class="code-prompt">$</span> curl -H <span class="code-string">"X-Owner-Token: $TOKEN"</span> --upload-file build.log https://send.to/build.log

<span class="code-prompt">$</span> curl -H <span class="code-string">"X-Owner-Token: $TOKEN"</span> https://send.to/owner/files
<span class="code-comment"># one share URL per line; Accept: application/json for the full records</span>`}
          />
        </section>

        <!-- Virus Scan -->
        <section id="scan" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.scan">
            Virus Scan
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.scanDesc">
            Scan uploaded files with ClamAV or VirusTotal (requires server configuration).
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">PUT</td>
                  <td class="px-4 py-2 font-mono text-xs">/{"{filename}"}/virustotal</td>
                  <td class="px-4 py-2">Submit to VirusTotal (requires --virustotal-key)</td>
                </tr>
                <tr>
                  <td class="px-4 py-2 font-mono text-xs text-accent">PUT</td>
                  <td class="px-4 py-2 font-mono text-xs">/{"{filename}"}/scan</td>
                  <td class="px-4 py-2">Scan with ClamAV (requires --clamav-host)</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="mb-4 text-xs text-muted-dark" data-i18n="api.scanNote">
            When --perform-clamav-prescan is enabled, all uploads are automatically scanned before
            being accepted. Infected files are rejected with HTTP 412. Both scan endpoints require
            the same authentication and rate limit as an upload.
          </p>
        </section>

        <!-- Operations -->
        <section id="ops" class="animate-on-scroll">
          <h2 class="mb-4 font-mono text-xl font-semibold text-primary" data-i18n="api.ops">
            Health &amp; Metrics
          </h2>
          <p class="mb-4 text-sm text-muted" data-i18n="api.opsDesc">
            Endpoints for probes, dashboards and share-link QR codes.
          </p>

          <div class="mb-4 overflow-x-auto rounded-lg border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-border bg-surface">
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Method</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Path</th>
                  <th class="px-4 py-2 text-left font-mono text-xs text-muted-dark">Description</th>
                </tr>
              </thead>
              <tbody class="text-muted">
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/health</td>
                  <td class="px-4 py-2"
                    >Status, version, storage backend, uptime (JSON on request)</td
                  >
                </tr>
                <tr class="border-b border-border">
                  <td class="px-4 py-2 font-mono text-xs text-accent">GET</td>
                  <td class="px-4 py-2 font-mono text-xs">/metrics</td>
                  <td class="px-4 py-2"
