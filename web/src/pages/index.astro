---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import UploadZone from "../components/UploadZone";
---

<BaseLayout>
  <!-- =============================================================
       Hero
       ============================================================= -->
  <section class="bg-background">
    <div class="mx-auto max-w-5xl px-6 pt-24 pb-16 text-center sm:pt-32 sm:pb-24">
      <div class="pill mx-auto mb-8 inline-flex">
        <span class="h-1.5 w-1.5 rounded-full bg-[#c96442]"></span>
        <span>Version 2.0 · Open source · MIT</span>
      </div>

      <h1
        class="font-serif text-[48px] font-medium leading-[1.1] text-primary sm:text-[64px] md:text-[84px]"
        data-i18n="hero.title"
      >
        The fastest way<br />to share a file.
      </h1>

      <p
        class="mx-auto mt-8 max-w-2xl text-[18px] leading-relaxed text-muted sm:text-[20px]"
        data-i18n="hero.subtitle"
      >
        Drop a file, get a link, paste it anywhere. A self-hosted file-sharing service that feels
        like a good piece of paper — warm, reliable, and yours.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="#upload" class="btn btn-primary">
          <span data-i18n="hero.cta.primary">Upload a file</span>
          <span aria-hidden>→</span>
        </a>
        <a href="#cli" class="btn btn-ghost">
          <span class="font-mono text-[13px] text-muted" data-i18n="hero.cta.code"
            >$ curl --upload-file file.txt</span
          >
        </a>
      </div>

      <p class="mt-6 text-sm text-muted-dark" data-i18n="hero.cta.note">
        No signup. No tracking. 52 MB Docker image.
      </p>
    </div>
  </section>

  <!-- =============================================================
       Upload zone — elevated on ivory
       ============================================================= -->
  <section id="upload" class="bg-background pb-24 sm:pb-32">
    <div class="mx-auto max-w-5xl px-6">
      <UploadZone client:load />
    </div>
  </section>

  <!-- =============================================================
       Features — editorial card grid
       ============================================================= -->
  <section class="border-t border-border bg-background">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <p
          class="mb-4 text-[13px] font-medium uppercase tracking-wide text-[#c96442]"
          data-i18n="features.label"
        >
          Built with care
        </p>
        <h2
          class="font-serif text-[36px] font-medium leading-tight text-primary sm:text-[52px]"
          data-i18n="features.title"
        >
          Every detail, considered.
        </h2>
        <p class="mt-6 text-[18px] leading-relaxed text-muted" data-i18n="features.subtitle">
          Self-hosted infrastructure shouldn't feel industrial. send.to is built to be pleasant to
          operate, pleasant to use, and pleasant to look at.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-[1.3fr_1fr]">
        <!-- Large: Encryption -->
        <article class="card animate-on-scroll stagger-1 flex flex-col justify-between p-10">
          <div>
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#c9644214]">
                <svg
                  class="h-5 w-5 text-[#c96442]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                  <path d="M7 11V7a5 5 0 0110 0v4"></path>
                </svg>
              </div>
              <span
                class="text-[13px] font-medium uppercase tracking-wide text-muted-dark"
                data-i18n="feature.encryption.label">Encryption</span
              >
            </div>
            <h3
              class="font-serif text-[32px] font-medium leading-tight text-primary"
              data-i18n="feature.encryption.title"
            >
              End-to-end encryption that just works.
            </h3>
            <p
              class="mt-4 text-[16px] leading-relaxed text-muted"
              data-i18n="feature.encryption.desc"
            >
              Add one header and your file is encrypted with OpenPGP AES-256 before touching disk.
              The server can't read it, and neither can your hosting provider.
            </p>
          </div>
          <div
            class="mt-8 flex items-center gap-3 rounded-xl border border-border bg-surface-light px-4 py-3"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#c96442]"></span>
            <code class="font-mono text-[13px] text-accent">X-Encrypt-Password: yourSecret</code>
          </div>
        </article>

        <!-- Dark: 7d expiry -->
        <article class="card-dark animate-on-scroll stagger-2 flex flex-col justify-between p-10">
          <div>
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#d9775733]">
                <svg
                  class="h-5 w-5 text-[#d97757]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 7v5l3 2"></path>
                </svg>
              </div>
              <span
                class="text-[13px] font-medium uppercase tracking-wide text-[#b0aea5]"
                data-i18n="feature.expiry.label">Auto-expiry</span
              >
            </div>
            <div class="mb-6">
              <p class="font-serif text-[96px] font-medium leading-none text-[#d97757]">7d</p>
              <p class="mt-2 text-[13px] text-[#b0aea5]" data-i18n="feature.expiry.caption">
                default ttl
              </p>
            </div>
          </div>
          <div>
            <h3
              class="font-serif text-[26px] font-medium leading-tight text-[#faf9f5]"
              data-i18n="feature.expiry.title"
            >
              Links that expire.
            </h3>
            <p
              class="mt-3 text-[15px] leading-relaxed text-[#b0aea5]"
              data-i18n="feature.expiry.desc"
            >
              Per-file Max-Days and Max-Downloads. The file — and the link — quietly vanish.
            </p>
          </div>
        </article>

        <!-- Storage backends -->
        <article class="card animate-on-scroll stagger-3 flex flex-col justify-between p-10">
          <div>
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#c9644214]">
                <svg
                  class="h-5 w-5 text-[#c96442]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5"></path>
                  <path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6"></path>
                </svg>
              </div>
              <span
                class="text-[13px] font-medium uppercase tracking-wide text-muted-dark"
                data-i18n="feature.storage.label">Storage</span
              >
            </div>
            <div class="mb-6 flex flex-wrap gap-2">
              <span
                class="rounded-lg border border-border bg-surface-light px-3 py-1.5 text-xs font-medium text-accent"
                >Local</span
              >
              <span
                class="rounded-lg border border-border bg-surface-light px-3 py-1.5 text-xs font-medium text-accent"
                >S3</span
              >
              <span
                class="rounded-lg border border-border bg-surface-light px-3 py-1.5 text-xs font-medium text-accent"
                >Minio</span
              >
            </div>
          </div>
          <div>
            <h3
              class="font-serif text-[26px] font-medium leading-tight text-primary"
              data-i18n="feature.storage.title"
            >
              One flag, either backend.
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted" data-i18n="feature.storage.desc">
              Local filesystem for dev, S3 for scale — Minio, DO Spaces or anything S3-compatible.
              Swap with a single CLI flag.
            </p>
          </div>
        </article>

        <!-- Hardening -->
        <article class="card animate-on-scroll stagger-4 flex flex-col justify-between p-10">
          <div>
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#c9644214]">
                <svg
                  class="h-5 w-5 text-[#c96442]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5l8-3z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              </div>
              <span
                class="text-[13px] font-medium uppercase tracking-wide text-muted-dark"
                data-i18n="feature.hardening.label">Hardening</span
              >
            </div>
            <ul class="mb-6 space-y-2.5 text-[14px] text-accent">
              <li>— Strict CSP, COOP/CORP, HSTS</li>
              <li>— Slow-loris timeouts, MaxBytesReader</li>
              <li>— Constant-time auth, per-IP rate limiting</li>
            </ul>
          </div>
          <div>
            <h3
              class="font-serif text-[26px] font-medium leading-tight text-primary"
              data-i18n="feature.hardening.title"
            >
              Hardened by default.
            </h3>
            <p
              class="mt-3 text-[15px] leading-relaxed text-muted"
              data-i18n="feature.hardening.desc"
            >
              Runs non-root on a scratch container. No shell, no package manager, no attack surface.
            </p>
          </div>
        </article>

        <!-- 52 MB -->
        <article
          class="card animate-on-scroll stagger-5 col-span-full flex flex-col justify-between p-10 lg:col-span-2"
        >
          <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
            <div>
              <div class="mb-4 flex items-center gap-3">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#c9644214]">
                  <svg
                    class="h-5 w-5 text-[#c96442]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="4 17 10 11 4 5"></polyline>
                    <line x1="12" y1="19" x2="20" y2="19"></line>
                  </svg>
                </div>
                <span
                  class="text-[13px] font-medium uppercase tracking-wide text-muted-dark"
                  data-i18n="feature.binary.label">Developer experience</span
                >
              </div>
              <h3
                class="font-serif text-[28px] font-medium leading-tight text-primary"
                data-i18n="feature.binary.title"
              >
                One binary, zero dependencies.
              </h3>
              <p
                class="mt-3 max-w-lg text-[15px] leading-relaxed text-muted"
                data-i18n="feature.binary.desc"
              >
                CGO_ENABLED=0 build runs on scratch. Cold starts under 50 ms. The whole container is
                smaller than a Slack message.
              </p>
            </div>
            <div class="flex items-baseline gap-6 lg:flex-col lg:items-end">
              <div class="text-right">
                <p class="font-serif text-[64px] font-medium leading-none text-[#c96442]">52</p>
                <p class="mt-1 text-[13px] text-muted-dark">MB image</p>
              </div>
              <div class="text-right">
                <p class="font-serif text-[40px] font-medium leading-none text-primary">&lt; 50</p>
                <p class="mt-1 text-[13px] text-muted-dark">ms cold start</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =============================================================
       Dark chapter — CLI / terminals
       ============================================================= -->
  <section id="cli" class="bg-dark">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <p
          class="mb-4 text-[13px] font-medium uppercase tracking-wide text-[#d97757]"
          data-i18n="cli.label"
        >
          For the command line
        </p>
        <h2
          class="font-serif text-[36px] font-medium leading-tight text-[#faf9f5] sm:text-[64px]"
          data-i18n="cli.title"
        >
          Your terminal is the UI.
        </h2>
        <p class="mt-6 text-[18px] leading-relaxed text-[#b0aea5]" data-i18n="cli.subtitle">
          Works with curl, wget, HTTPie, PowerShell — anything that speaks HTTP. Headers do all the
          work.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        <CodeBlock
          title="Upload a file"
          titleKey="code.uploadFile"
          code={`<span class="code-prompt">$</span> curl --upload-file ./report.pdf \\
    https://send.to/report.pdf

<span class="code-string">→ https://send.to/aB3cD4eF/report.pdf</span>`}
        />
        <CodeBlock
          title="Encrypt on upload"
          titleKey="code.encryptUpload"
          code={`<span class="code-prompt">$</span> curl \\
    -H <span class="code-string">"X-Encrypt-Password: s3cret"</span> \\
    --upload-file ./vault.zip \\
    https://send.to/vault.zip`}
        />
        <CodeBlock
          title="Limit downloads"
          titleKey="code.setLimits"
          code={`<span class="code-comment" data-i18n="code.comment.setLimits"># max 5 downloads, 7-day expiry</span>

<span class="code-prompt">$</span> curl -H <span class="code-string">"Max-Downloads: 5"</span> \\
    -H <span class="code-string">"Max-Days: 7"</span> \\
    --upload-file ./build.tgz ...`}
        />
      </div>
    </div>
  </section>

  <!-- =============================================================
       How it works — 3 steps
       ============================================================= -->
  <section class="bg-background">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <p
          class="mb-4 text-[13px] font-medium uppercase tracking-wide text-[#c96442]"
          data-i18n="flow.label"
        >
          Three steps
        </p>
        <h2
          class="font-serif text-[36px] font-medium leading-tight text-primary sm:text-[52px]"
          data-i18n="flow.title"
        >
          That's the whole API.
        </h2>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <article class="card animate-on-scroll stagger-1 flex flex-col gap-4 p-8">
          <p class="font-serif text-[48px] font-medium leading-none text-[#c96442]">01</p>
          <h3
            class="font-serif text-[26px] font-medium leading-tight text-primary"
            data-i18n="flow.step1.title"
          >
            Upload
          </h3>
          <p class="text-[15px] leading-relaxed text-muted" data-i18n="flow.step1.desc">
            PUT any file to any URL. The body is the file; headers configure expiry, download caps,
            and encryption.
          </p>
          <div
            class="mt-2 flex items-center gap-2 rounded-lg border border-border bg-surface-light px-3 py-2"
          >
            <code class="font-mono text-[13px] text-accent">PUT /report.pdf</code>
          </div>
        </article>

        <article class="card animate-on-scroll stagger-2 flex flex-col gap-4 p-8">
          <p class="font-serif text-[48px] font-medium leading-none text-[#c96442]">02</p>
          <h3
            class="font-serif text-[26px] font-medium leading-tight text-primary"
            data-i18n="flow.step2.title"
          >
            Share
          </h3>
          <p class="text-[15px] leading-relaxed text-muted" data-i18n="flow.step2.desc">
            Paste the token URL into chat, a CI log, an email — anywhere. No login required to
            download.
          </p>
          <div
            class="mt-2 flex items-center gap-2 rounded-lg border border-border bg-surface-light px-3 py-2"
          >
            <code class="font-mono text-[13px] text-accent">→ /aB3cD4eF/report.pdf</code>
          </div>
        </article>

        <article class="card animate-on-scroll stagger-3 flex flex-col gap-4 p-8">
          <p class="font-serif text-[48px] font-medium leading-none text-[#c96442]">03</p>
          <h3
            class="font-serif text-[26px] font-medium leading-tight text-primary"
            data-i18n="flow.step3.title"
          >
            Forget
          </h3>
          <p class="text-[15px] leading-relaxed text-muted" data-i18n="flow.step3.desc">
            Files auto-expire per your limits. Or use the one-shot DELETE URL returned on upload to
            remove it now.
          </p>
          <div
            class="mt-2 flex items-center gap-2 rounded-lg border border-border bg-surface-light px-3 py-2"
          >
            <code class="font-mono text-[13px] text-accent">DELETE when done</code>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =============================================================
       Final CTA — dark tile on parchment
       ============================================================= -->
  <section class="bg-background pb-24 sm:pb-32">
    <div class="mx-auto max-w-6xl px-6">
      <div
        class="rounded-[32px] bg-dark px-6 py-20 text-center shadow-[0_12px_40px_rgba(0,0,0,0.08)] sm:px-16 sm:py-24"
      >
        <p
          class="mb-4 text-[13px] font-medium uppercase tracking-wide text-[#d97757]"
          data-i18n="finalcta.label"
        >
          Ready to ship
        </p>
        <h2
          class="font-serif mx-auto max-w-3xl text-[40px] font-medium leading-[1.1] text-[#faf9f5] sm:text-[64px]"
          data-i18n="finalcta.title"
        >
          Stop emailing files.<br />Start sending them.
        </h2>
        <p
          class="mx-auto mt-6 max-w-xl text-[18px] leading-relaxed text-[#b0aea5]"
          data-i18n="finalcta.subtitle"
        >
          One docker compose up and you have a production-hardened file sharing service on your own
          domain. It takes about thirty seconds.
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <a
            href="https://github.com/sooua/send.to"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            <span data-i18n="finalcta.cta.primary">Get started</span>
            <span aria-hidden>→</span>
          </a>
          <a
            href="https://github.com/sooua/send.to"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-dark"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8L2 9.3l6.9-1z"
              ></path>
            </svg>
            Star on GitHub
          </a>
        </div>
        <p class="mt-8 text-[13px] text-[#87867f]" data-i18n="finalcta.meta">
          Open source · MIT · no tracking · 52 MB image
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
